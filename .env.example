# Copy to .env and fill in. Never commit the real .env file.
# The application reads these at startup.

# --- Core (required in production) -----------------------------------------
# Signs JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app generates an ephemeral key and logs in users will be
# logged out on every restart.
SECRET_KEY=

# Turn off in production. Do not run the Werkzeug debugger on a public host.
FLASK_DEBUG=false

# --- Optional ---------------------------------------------------------------
# Database URL. Defaults to a local SQLite file (instance/users.db).
# DATABASE_URL=sqlite:///users.db

# Bind address and port for `python app.py`.
# HOST=127.0.0.1
# PORT=5000

# Maximum accepted upload size, in megabytes.
# MAX_UPLOAD_MB=20

# Comma-separated list of trusted cross-origin API callers. If empty, the API
# is same-origin only.
# CORS_ORIGINS=https://grader.example.edu

# Rate-limit storage. memory:// is fine for a single process; use Redis for
# multiple workers, e.g. redis://localhost:6379.
# RATELIMIT_STORAGE_URI=memory://

# Public base URL used to build password-reset links in emails.
# APP_BASE_URL=https://grader.example.edu

# Set to true only when TLS terminates in front of the app (e.g. a reverse
# proxy) so HSTS is sent even though the app sees plain HTTP.
# FORCE_HTTPS=false

# --- SMTP (password reset email) -------------------------------------------
# Without SMTP_HOST, reset emails are not sent (the request still succeeds
# silently to avoid leaking which emails exist).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_USE_TLS=true
